{
  "name": "astra-dashboard",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --kill-others --names FRONTEND,BACKEND --prefix-colors cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite --host localhost --port 5173",
    "dev:backend": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:xss-guard": "node scripts/ci/xss-guard.mjs",
    "ci:lint-security": "npm run lint:xss-guard",
    "preview": "vite preview",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.2.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  }
}
