# Discord OAuth2 – aus dem Discord Developer Portal
# https://discord.com/developers/applications/<APP_ID>/oauth2
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/discord/callback
FRONTEND_URL=http://localhost:5173

# Session-Konfiguration
# Generiere mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME_min_32_characters_long_random_string
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE=2592000
SESSION_INACTIVITY_TIMEOUT=2592000

# CORS – kommaseparierte Origins
CORS_ORIGINS=http://localhost:5173

# Interne Astra Bot API
ASTRA_INTERNAL_API_URL=http://127.0.0.1:5000
ASTRA_INTERNAL_API_KEY=

# MySQL-Datenbank
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=astra_dashboard
DB_USER=astra_dashboard
DB_PASSWORD=
